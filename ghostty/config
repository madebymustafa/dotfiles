# Requires ~/.hushlogin to suppress "Last login" message
theme = catppuccin-mocha
font-family = "JetBrains Mono"
font-size = 19
# Borderless + native rounded corners (port of WezTerm's "RESIZE" decorations):
# - do NOT use `window-decoration = false` here - on macOS that strips the
#   native frame AND squared the corners.
# - `macos-titlebar-style = hidden` hides the titlebar but keeps the native
#   rounded-corner frame, matching WezTerm.
macos-titlebar-style = hidden
# macOS 26 (Tahoe) draws a tiny grey 1px border around any non-borderless
# window that has its shadow enabled (a documented AppKit/Liquid Glass change).
# Disabling the shadow removes that border - this is the upstream-documented
# workaround (ghostty-org/ghostty#9582).
macos-window-shadow = false
background-opacity = 0.8
background-blur-radius = 20
# Top/bottom padding so the first line doesn't touch the window edge
# (matches WezTerm's top = 20 padding).
window-padding-y = 20

# Open URLs by holding Cmd (macOS) / Ctrl (Linux) and clicking.
# `link-url` is on by default; set explicitly for clarity.
# NOTE: Inside apps that enable "mouse reporting" (tmux, vim, lazygit, TUI
# CLIs), Cmd+click on macOS cannot open links because the Command modifier
# can't travel through the xterm mouse protocol — the click is swallowed by
# the app. Use Cmd+Shift+click in those apps (Shift is Ghostty's mouse-capture
# bypass). This is an upstream Ghostty limitation, not a config issue.
link-url = true
mouse-hide-while-typing = true
macos-option-as-alt = true
macos-non-native-fullscreen = true
gtk-titlebar = true
