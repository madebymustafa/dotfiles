{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "//": "Bracketed layout matching the video: centered title, rounded bracket rails framing content with small margins, single circle palette row outside (below) the bottom rail.",
    "//2": "GEOMETRY CONTRACT: rail 55 wide, balanced margins - label at V+4 (left) and longest value ends at V+49, so ╮ sits 4 cols after it (right). Values start at V+14. Title pad (55-${#p})/2 and 20-space circle pad center both over the rail. Logo padding right 6 sets V (30-wide logo + 6). Change these together.",
  "logo": {
    "type": "builtin",
    "source": "macos",
    "padding": {
      "right": 6
    }
  },
  "display": {
    "separator": ": ",
    "key": {
      "width": 15
    },
    "color": {
      "keys": "#cba6f7",
      "title": "#cba6f7"
    }
  },
  "modules": [
    {
      "type": "command",
      "key": " ",
      "text": "p=\"$(printf '%s@%s' \"$USER\" \"$(ipconfig getifaddr en0)\")\"; printf '%*s%s' \"$(( (55 - ${#p}) / 2 ))\" \"\" \"$p\"",
      "outputColor": "#cba6f7"
    },
    {
      "type": "custom",
      "key": " ",
      "format": "╭─────────────────────────────────────────────────────╮",
      "outputColor": "#cba6f7"
    },
    {
      "type": "os",
      "key": "    OS",
      "format": "{name} {version} {arch}"
    },
    {
      "type": "command",
      "key": "    Host",
      "text": "fastfetch -c \"$HOME/.config/fastfetch/host.jsonc\" 2>/dev/null | sed -E 's/[[:space:]]*,[[:space:]]*[^,()]*Thunderbolt[^()]*//' | tr -d '\\n'"
    },
    {
      "type": "kernel",
      "key": "    Kernel"
    },
    {
      "type": "uptime",
      "key": "    Uptime"
    },
    {
      "type": "packages",
      "key": "    Packages"
    },
    {
      "type": "shell",
      "key": "    Shell"
    },
    {
      "type": "wm",
      "key": "    WM"
    },
    {
      "type": "custom",
      "key": "    Icons",
      "format": "System"
    },
    {
      "type": "custom",
      "key": "    Terminal",
      "format": "Ghostty"
    },
    {
      "type": "memory",
      "key": "    Memory"
    },
    {
      "type": "disk",
      "key": "    Disk",
      "format": "{size-used} / {size-total} ({size-percentage}) - {filesystem}"
    },
    {
      "type": "battery",
      "key": "    Battery"
    },
    {
      "type": "custom",
      "key": " ",
      "format": "╰─────────────────────────────────────────────────────╯",
      "outputColor": "#cba6f7"
    },
    {
      "type": "command",
      "key": " ",
      "text": "printf '%*s' 20 ''; printf '\\033[30m● \\033[31m● \\033[32m● \\033[33m● \\033[34m● \\033[35m● \\033[36m● \\033[37m●'"
    }
  ]
}
